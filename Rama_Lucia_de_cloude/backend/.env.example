# Backend ArcanStudios - configuración
# Copia este archivo a .env y completa los valores. .env NO se sube a git.

# --- Servidor ---
PORT=3001

# --- Base de datos (MariaDB / MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=
DB_NAME=BD_ARCAN

# --- JWT ---
# Genera una cadena aleatoria larga (>=32 caracteres).
# Por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_una_cadena_muy_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# --- CORS ---
# Origen del frontend (Next.js). En desarrollo suele ser http://localhost:3000
CORS_ORIGIN=http://localhost:3000
